#!/bin/sh
set -eu

repo_root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

cw_commit=6051fcc0a1084a4e96d9880703a3e84955fee42a
cw_home=$(dirname -- "$repo_root")/.odibi-context-workbench-state
cw_repository_url=https://github.com/henryodibi11/context_workbench.git
cw_source_url="git+https://github.com/henryodibi11/context_workbench.git@$cw_commit"

install_context_workbench() {
    if [ -n "${CW_GITHUB_TOKEN:-}" ]; then
        (
            askpass=$(mktemp)
            trap 'rm -f "$askpass"' 0 1 2 15
            cat >"$askpass" <<'SH'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\n' x-access-token ;;
    *Password*) printf '%s\n' "$CW_GITHUB_TOKEN" ;;
    *) exit 1 ;;
esac
SH
            chmod 700 "$askpass"
            GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
                GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 \
                .venv/bin/python -m pip install -e . pytest \
                "context-workbench[mcp] @ $cw_source_url"
            GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
                GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 \
                .venv/bin/python -m pip install --force-reinstall --no-deps \
                "context-workbench[mcp] @ $cw_source_url"
        )
        return
    fi

    if ! GIT_TERMINAL_PROMPT=0 git ls-remote --exit-code "$cw_repository_url" HEAD >/dev/null 2>&1; then
        echo "Cannot read the private Context Workbench repository." >&2
        echo "Configure CW_GITHUB_TOKEN as an Amp Project secret or authenticate Git locally." >&2
        return 1
    fi
    GIT_TERMINAL_PROMPT=0 .venv/bin/python -m pip install -e . pytest \
        "context-workbench[mcp] @ $cw_source_url"
    GIT_TERMINAL_PROMPT=0 .venv/bin/python -m pip install --force-reinstall --no-deps \
        "context-workbench[mcp] @ $cw_source_url"
}

python3 - <<'PY'
import sys
if sys.version_info < (3, 11):
    raise SystemExit("Odibi Amp integration requires Python 3.11 or newer")
PY

if [ ! -x .venv/bin/python ]; then
    python3 -m venv .venv
fi

install_context_workbench
.venv/bin/python -m pip check
.venv/bin/python -m pytest --collect-only -q tests/test_config.py
.venv/bin/python -m pytest -q tests/test_config.py::TestReadConfig::test_valid_read_config_with_path
CW_REVISION="$cw_commit" CW_PROJECT_ROOT="$repo_root" CW_HOME="$cw_home" \
    .venv/bin/python - <<'PY'
import json
import os
from importlib.metadata import distribution
from pathlib import Path

import context_workbench.mcp_server
from context_workbench.bootstrap import init

metadata = distribution("context-workbench").read_text("direct_url.json")
direct_url = json.loads(metadata or "{}")
if direct_url.get("vcs_info", {}).get("commit_id") != os.environ["CW_REVISION"]:
    raise RuntimeError("Context Workbench revision does not match the Odibi project pin")
project_root = Path(os.environ["CW_PROJECT_ROOT"]).resolve()
cw_home = Path(os.environ["CW_HOME"]).resolve()
cw, root, _ = init(root=str(project_root))
status = cw("status", output_format="dict")
assert Path(root).resolve() == project_root
assert Path(status["runtime"]["artifact_root"]).resolve() == cw_home
assert Path(status["runtime"]["target_root"]).resolve() == project_root
PY
